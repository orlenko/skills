{
  "description": "Surface Agent Pair inbox metadata and unclaimed Stop-hook body previews to Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/agent-pair hook-context --provider codex",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/agent-pair hook-context --provider codex",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/agent-pair hook-stop --provider codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
